[gd_scene load_steps=7 format=3 uid="uid://thrown_vortex_01"]

[sub_resource type="GDScript" id="GDScript_tv"]
script/source = "extends CharacterBody3D

@export var speed: float = 16.0
var velocity_vector: Vector3 = Vector3.ZERO
var gravity: float = 18.0
var has_deployed: bool = false
var duration: float = 4.0
var pull_radius: float = 9.0

func setup(dir: Vector3) -> void:
	velocity_vector = dir * speed + Vector3.UP * 3.5

func _physics_process(delta: float) -> void:
	if not has_deployed:
		velocity_vector.y -= gravity * delta
		var collision = move_and_collide(velocity_vector * delta)
		$MeshInstance3D.rotate_x(12.0 * delta)
		$MeshInstance3D.rotate_y(8.0 * delta)
		if collision:
			deploy_vortex()
	else:
		$MeshInstance3D.rotate_y(15.0 * delta)
		if multiplayer.is_server():
			_pull_enemies(delta)

func deploy_vortex() -> void:
	if has_deployed:
		return
	has_deployed = true
	velocity_vector = Vector3.ZERO
	$MeshInstance3D.scale = Vector3(1.8, 1.8, 1.8)
	$VortexParticles.emitting = true
	$OmniLight3D.light_energy = 8.0
	
	await get_tree().create_timer(duration).timeout
	queue_free()

func _pull_enemies(delta: float) -> void:
	var space = get_world_3d().direct_space_state
	var query = PhysicsShapeQueryParameters3D.new()
	var sphere = SphereShape3D.new()
	sphere.radius = pull_radius
	query.shape = sphere
	query.transform = global_transform
	query.collision_mask = 7

	var hits = space.intersect_shape(query, 64)
	for h in hits:
		var body = h.collider
		if body == self:
			continue
		var diff = global_position - body.global_position
		diff.y = 0
		var dist = diff.length()
		if dist > 0.5:
			var pull_dir = diff.normalized()
			if body.is_in_group(\"enemies\"):
				body.velocity = body.velocity.lerp(pull_dir * 12.0, 10.0 * delta)
			elif body is RigidBody3D:
				body.apply_central_impulse(pull_dir * 18.0 * delta)
"

