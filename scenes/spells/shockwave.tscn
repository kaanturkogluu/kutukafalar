[gd_scene load_steps=10 format=3 uid="uid://shockwave_emp_01"]

[sub_resource type="GDScript" id="GDScript_shockwave"]
script/source = "extends Node3D

@export var max_radius: float = 14.0
@export var stun_duration: float = 1.2
@export var knockback_force: float = 22.0
@export var damage: float = 80.0

@onready var ring_mesh: MeshInstance3D = $ShockRing
@onready var spark_particles: GPUParticles3D = $SparkParticles

func _ready() -> void:
	SoundManager.play_3d_sfx(\"rocket\", global_position, 0.5, 1.4)
	
	if spark_particles:
		spark_particles.emitting = true
	
	# Görsel genişleme animasyonu (Tween)
	if ring_mesh:
		ring_mesh.scale = Vector3(0.1, 0.1, 0.1)
		var tw = create_tween()
		tw.set_parallel(true)
		tw.tween_property(ring_mesh, \"scale\", Vector3(max_radius * 2.0, 1.0, max_radius * 2.0), 0.45).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		if ring_mesh.material_override:
			tw.tween_property(ring_mesh.material_override, \"albedo_color:a\", 0.0, 0.45)
	
	# Fizik ve etki SADECE sunucuda (Host) hesaplanır
	if multiplayer.is_server():
		var space = get_world_3d().direct_space_state
		var query = PhysicsShapeQueryParameters3D.new()
		var sphere = SphereShape3D.new()
		sphere.radius = max_radius
		query.shape = sphere
		query.transform = global_transform
		query.collision_mask = 7
		
		var hit_nodes: Array[Node] = []
		for hit in space.intersect_shape(query, 64):
			var body = hit.collider
			if body and not hit_nodes.has(body):
				hit_nodes.append(body)
				if body.is_in_group(\"enemies\"):
					var dir = (body.global_position - global_position)
					dir.y = 0.0
					if dir.length_squared() < 0.01:
						dir = Vector3(randf_range(-1, 1), 0, randf_range(-1, 1))
					dir = dir.normalized()
					var launch_vec = dir * knockback_force + Vector3.UP * 4.8
					
					# Geri Fırlatma (Knockback)
					if body.has_method(\"apply_knockback\"):
						body.apply_knockback(launch_vec)
					
					# 1.2 Saniye Sersemletme (Stun)
					if body.has_method(\"stun\"):
						body.stun(stun_duration)
					
					# Hasar
					if body.has_method(\"take_damage\"):
						body.take_damage(damage, false, global_position)
	
	await get_tree().create_timer(0.6).timeout
	queue_free()
"

