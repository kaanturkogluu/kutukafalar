[gd_scene load_steps=7 format=3 uid="uid://fire_wave_01"]

[sub_resource type="GDScript" id="GDScript_fire_wave"]
script/source = "extends Area3D

@export var speed: float = 14.0
@export var damage: float = 65.0
var direction: Vector3 = Vector3.FORWARD
var hit_enemies: Array = []

func _ready() -> void:
	$FireParticles.emitting = true
	await get_tree().create_timer(1.6).timeout
	queue_free()

func _physics_process(delta: float) -> void:
	global_position += direction * speed * delta

func _on_body_entered(body: Node3D) -> void:
	if not multiplayer.is_server():
		return
	if body.is_in_group(\"enemies\") and not hit_enemies.has(body):
		hit_enemies.append(body)
		if body.has_method(\"take_damage\"):
			body.take_damage(damage, false, global_position)
		body.velocity += direction * 8.0 + Vector3.UP * 2.0
	elif body.is_in_group(\"barrels\") and body.has_method(\"take_damage\"):
		body.take_damage(damage, false, global_position)
"

