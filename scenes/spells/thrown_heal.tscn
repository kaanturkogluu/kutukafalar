[gd_scene load_steps=7 format=3 uid="uid://thrown_heal_01"]

[sub_resource type="GDScript" id="GDScript_th"]
script/source = "extends CharacterBody3D

@export var speed: float = 17.0
var velocity_vector: Vector3 = Vector3.ZERO
var gravity: float = 19.0
var has_deployed: bool = false
var heal_radius: float = 6.5
var duration: float = 5.0

func setup(dir: Vector3) -> void:
	velocity_vector = dir * speed + Vector3.UP * 3.5

func _physics_process(delta: float) -> void:
	if not has_deployed:
		velocity_vector.y -= gravity * delta
		var collision = move_and_collide(velocity_vector * delta)
		$MeshInstance3D.rotate_x(10.0 * delta)
		if collision:
			deploy_heal_zone()
	else:
		if multiplayer.is_server():
			_heal_tick(delta)

func deploy_heal_zone() -> void:
	if has_deployed:
		return
	has_deployed = true
	velocity_vector = Vector3.ZERO
	$MeshInstance3D.visible = false
	$HealParticles.emitting = true
	$OmniLight3D.light_energy = 5.0
	
	await get_tree().create_timer(duration).timeout
	queue_free()

func _heal_tick(delta: float) -> void:
	var space = get_world_3d().direct_space_state
	var query = PhysicsShapeQueryParameters3D.new()
	var sphere = SphereShape3D.new()
	sphere.radius = heal_radius
	query.shape = sphere
	query.transform = global_transform
	query.collision_mask = 7

	var hits = space.intersect_shape(query, 32)
	for h in hits:
		var body = h.collider
		# Takım arkadaşlarını iyileştir
		if body.is_in_group(\"players\") and body.has_method(\"take_damage\"):
			body.current_health = clamp(body.current_health + 15.0 * delta, 0, body.max_health)
			body._update_hud()
		# Zombilere asit hasarı
		elif body.is_in_group(\"enemies\") and body.has_method(\"take_damage\"):
			body.take_damage(20.0 * delta, false, global_position)
"

