[gd_scene load_steps=7 format=3 uid="uid://thrown_frost_01"]

[sub_resource type="GDScript" id="GDScript_tf"]
script/source = "extends CharacterBody3D

@export var speed: float = 18.0
var velocity_vector: Vector3 = Vector3.ZERO
var gravity: float = 20.0
var freeze_radius: float = 8.5
var freeze_duration: float = 4.5
var damage: float = 45.0

func setup(dir: Vector3) -> void:
	velocity_vector = dir * speed + Vector3.UP * 3.5

func _physics_process(delta: float) -> void:
	velocity_vector.y -= gravity * delta
	$MeshInstance3D.rotate_x(10.0 * delta)
	$MeshInstance3D.rotate_z(8.0 * delta)
	
	var collision = move_and_collide(velocity_vector * delta)
	if collision:
		explode_frost()

func explode_frost() -> void:
	$MeshInstance3D.visible = false
	$IceParticles.emitting = true
	$OmniLight3D.light_energy = 6.0
	
	if multiplayer.is_server():
		var space = get_world_3d().direct_space_state
		var query = PhysicsShapeQueryParameters3D.new()
		var sphere = SphereShape3D.new()
		sphere.radius = freeze_radius
		query.shape = sphere
		query.transform = global_transform
		query.collision_mask = 7

		var hits = space.intersect_shape(query, 64)
		for h in hits:
			var body = h.collider
			if body.is_in_group(\"enemies\"):
				if body.has_method(\"freeze\"):
					body.freeze(freeze_duration)
				if body.has_method(\"take_damage\"):
					body.take_damage(damage, false, global_position)
	
	await get_tree().create_timer(1.2).timeout
	queue_free()
"

