[gd_scene load_steps=8 format=3 uid="uid://barrel_explosion_01"]

[sub_resource type="GDScript" id="GDScript_exp"]
script/source = "extends Node3D

func _ready() -> void:
	$OmniLight3D.light_energy = 8.0
	$FireParticles.emitting = true
	$DebrisParticles.emitting = true
	
	# Işığı hızlıca söndür
	var tween = create_tween()
	tween.tween_property($OmniLight3D, \"light_energy\", 0.0, 0.4)
	
	await get_tree().create_timer(1.5).timeout
	queue_free()
"

