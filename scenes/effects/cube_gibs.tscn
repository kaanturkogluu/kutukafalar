[gd_scene load_steps=5 format=3 uid="uid://cube_gibs_01"]

[sub_resource type="GDScript" id="GDScript_gibs"]
script/source = "extends Node3D

func _ready() -> void:
	for child in get_children():
		if child is RigidBody3D:
			var rand_impulse = Vector3(
				randf_range(-3.0, 3.0),
				randf_range(3.0, 6.0),
				randf_range(-3.0, 3.0)
			)
			child.apply_central_impulse(rand_impulse)
			child.apply_torque_impulse(Vector3(randf_range(-5, 5), randf_range(-5, 5), randf_range(-5, 5)))
	
	await get_tree().create_timer(2.0).timeout
	queue_free()
"

