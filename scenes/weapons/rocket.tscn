[gd_scene load_steps=7 format=3 uid="uid://rocket_scene_01"]

[sub_resource type="GDScript" id="GDScript_rocket"]
script/source = "extends Area3D

@export var speed: float = 26.0
@export var damage: float = 350.0
@export var explosion_radius: float = 6.0
var direction: Vector3 = Vector3.FORWARD
var has_exploded: bool = false

const EXPLOSION_EFFECT_PATH = \"res://scenes/effects/barrel_explosion.tscn\"

func _ready() -> void:
	$TrailParticles.emitting = true
	await get_tree().create_timer(4.0).timeout
	explode()

func _physics_process(delta: float) -> void:
	if not has_exploded:
		global_position += direction * speed * delta

func _on_body_entered(body: Node3D) -> void:
	explode()

func explode() -> void:
	if has_exploded:
		return
	has_exploded = true
	
	var exp_scene = load(EXPLOSION_EFFECT_PATH)
	if exp_scene:
		var exp_node = exp_scene.instantiate()
		get_parent().add_child(exp_node)
		exp_node.global_position = global_position
		
	if multiplayer.is_server():
		var space = get_world_3d().direct_space_state
		var query = PhysicsShapeQueryParameters3D.new()
		var sphere = SphereShape3D.new()
		sphere.radius = explosion_radius
		query.shape = sphere
		query.transform = global_transform
		query.collision_mask = 7
		
		for hit in space.intersect_shape(query, 64):
			var b = hit.collider
			if b.is_in_group(\"enemies\") and b.has_method(\"take_damage\"):
				b.take_damage(damage, false, global_position)
			elif b.is_in_group(\"barrels\") and b.has_method(\"take_damage\"):
				b.take_damage(damage, false, global_position)
	
	queue_free()
"

