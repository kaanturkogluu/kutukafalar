[gd_scene load_steps=7 format=3 uid="uid://pickup_scene_01"]

[sub_resource type="GDScript" id="GDScript_pickup"]
script/source = "extends Area3D

# Types: \"gold\", \"shotgun\", \"uzi\", \"rocket\", \"barrel\", \"health\"
@export var pickup_type: String = \"gold\"
@export var amount: int = 15

var bob_timer: float = 0.0
var initial_y: float = 0.0

func _ready() -> void:
	add_to_group(\"pickups\")
	initial_y = position.y
	_apply_visuals()
	body_entered.connect(_on_body_entered)

func _physics_process(delta: float) -> void:
	rotate_y(3.0 * delta)
	bob_timer += delta * 4.0
	position.y = initial_y + sin(bob_timer) * 0.15

func _apply_visuals() -> void:
	var mat = StandardMaterial3D.new()
	mat.roughness = 0.3
	mat.emission_enabled = true
	
	match pickup_type:
		\"gold\":
			mat.albedo_color = Color(1.0, 0.85, 0.1)
			mat.emission = Color(1.0, 0.75, 0.1)
			$Label3D.text = \"+ALTIN 🪙\"
		\"shotgun\":
			mat.albedo_color = Color(0.9, 0.3, 0.1)
			mat.emission = Color(0.8, 0.2, 0.05)
			$Label3D.text = \"POMPALI 💥\"
		\"uzi\":
			mat.albedo_color = Color(0.2, 0.8, 0.3)
			mat.emission = Color(0.1, 0.7, 0.2)
			$Label3D.text = \"UZI ⚡\"
		\"bixi\":
			mat.albedo_color = Color(0.2, 0.45, 0.25)
			mat.emission = Color(0.15, 0.4, 0.2)
			$Label3D.text = \"BİXİ 💥\"
		\"rocket\":
			mat.albedo_color = Color(0.9, 0.1, 0.8)
			mat.emission = Color(0.8, 0.05, 0.7)
			$Label3D.text = \"ROKET 🚀\"
		\"barrel\":
			mat.albedo_color = Color(0.9, 0.1, 0.1)
			mat.emission = Color(0.8, 0.05, 0.05)
			$Label3D.text = \"+VARİL 📦\"
		\"health\":
			mat.albedo_color = Color(0.1, 0.7, 1.0)
			mat.emission = Color(0.05, 0.6, 0.9)
			$Label3D.text = \"+CAN ❤️\"
			
	mat.emission_energy_multiplier = 2.0
	$MeshInstance3D.material_override = mat

func _on_body_entered(body: Node3D) -> void:
	if not multiplayer.is_server():
		return
	if body.is_in_group(\"players\") and body.has_method(\"apply_pickup\"):
		body.apply_pickup(pickup_type, amount)
		_collect.rpc()

@rpc(\"call_local\", \"reliable\")
func _collect() -> void:
	queue_free()
"

[sub_resource type="SphereShape3D" id="SphereShape3D_p"]
radius = 0.8

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_gold"]
albedo_color = Color(1, 0.85, 0.1, 1)
emission_enabled = true
emission = Color(1, 0.75, 0.1, 1)

[sub_resource type="BoxMesh" id="BoxMesh_pickup"]
material = SubResource("StandardMaterial3D_gold")
size = Vector3(0.4, 0.4, 0.4)

[sub_resource type="SceneReplicationConfig" id="SceneReplicationConfig_pickup"]
properties/0/path = NodePath(".:position")
properties/0/spawn = true
properties/0/replication_mode = 1
properties/1/path = NodePath(".:pickup_type")
properties/1/spawn = true
properties/1/replication_mode = 1

[node name="Pickup" type="Area3D"]
collision_layer = 0
collision_mask = 2
script = SubResource("GDScript_pickup")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("SphereShape3D_p")

[node name="MeshInstance3D" type="MeshInstance3D" parent="."]
mesh = SubResource("BoxMesh_pickup")

[node name="Label3D" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.55, 0)
billboard = 1
no_depth_test = true
text = "+ALTIN"
font_size = 22
outline_size = 6

[node name="MultiplayerSynchronizer" type="MultiplayerSynchronizer" parent="."]
replication_config = SubResource("SceneReplicationConfig_pickup")
